# SysBroom — .gitignore

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Entornos virtuales ────────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
.env

# ── Logs y reportes generados ─────────────────────────────────────────────────
logs/
*.log

# ── Config local (puede tener rutas personales) ───────────────────────────────
# config.json  <- incluido en repo con valores por defecto

# ── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ── Sistema ───────────────────────────────────────────────────────────────────
Thumbs.db
.DS_Store
desktop.ini

# ── Tests y cobertura ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
